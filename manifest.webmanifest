{
  "name": "Lacets – balades moto",
  "short_name": "Lacets",
  "description": "Lire des GPX, planifier des itinéraires moto, enregistrer ses balades avec photos et partager les sorties.",
  "lang": "fr",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16191d",
  "theme_color": "#16191d",
  "categories": ["navigation", "travel", "sports"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Planifier un parcours", "short_name": "Planifier", "url": "./?ecran=planifier", "icons": [{ "src": "icons/shortcut-plan.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Rouler", "url": "./?ecran=rouler", "icons": [{ "src": "icons/shortcut-plan.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Mes parcours", "short_name": "Parcours", "url": "./?ecran=parcours", "icons": [{ "src": "icons/shortcut-plan.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "gpx", "accept": [".gpx", "application/gpx+xml", "application/xml", "text/xml", "application/octet-stream"] }
      ]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/gpx+xml": [".gpx"] } }
  ]
}
